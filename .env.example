# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NODEMAILER / SMTP CONFIGURATION
# Optional in development (the server falls back to an interactive test/preview mode).
# In production on Hostinger or Vercel, configure these for real email delivery:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="amitktamse@gmail.com"
SMTP_PASS="your-app-password"
CONTACT_RECEIVER_EMAIL="amitktamse@gmail.com"
